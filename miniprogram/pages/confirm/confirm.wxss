.page {
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 24rpx;
  padding: 8rpx 32rpx;
  border-radius: 16rpx;
  background: #fff;
}

.summary-head {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.summary-thumb {
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
  background: var(--bg);
}

.summary-title {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.summary-name {
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: var(--text);
}

.summary-meta {
  font-size: 24rpx;
  color: var(--text-3);
}

.summary-row {
  display: flex;
  align-items: baseline;
  padding: 20rpx 0;
}

.summary-row + .summary-row {
  border-top: 1rpx solid var(--line);
}

.key {
  flex: 0 0 140rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.value-strong {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--must-blue);
}

.field {
  padding: 24rpx 0;
}

.field + .field {
  border-top: 1rpx solid var(--line);
}

.label {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.required {
  margin-left: 6rpx;
  color: var(--danger);
}

.input,
.textarea {
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fafbfc;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}

.input {
  height: 84rpx;
}

.textarea {
  height: 220rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  line-height: 1.5;
}

.input-error {
  border-color: var(--danger);
  background: #fffafa;
}

.placeholder {
  color: var(--text-3);
}

.field-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.error {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--danger);
}

.field-foot .error {
  margin-top: 0;
}

.counter {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-3);
}

.submit {
  margin-top: 16rpx;
}
