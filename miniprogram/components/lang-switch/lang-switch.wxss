.switch {
  display: inline-flex;
  padding: 4rpx;
  border-radius: 999rpx;
  background: rgba(0, 108, 186, 0.08);
}

.opt {
  min-width: 80rpx;
  height: 60rpx;
  padding: 0 18rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--must-blue);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.opt.on {
  background: var(--must-blue);
  color: #fff;
}
