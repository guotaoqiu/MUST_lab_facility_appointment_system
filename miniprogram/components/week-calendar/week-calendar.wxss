/* The time column is 80rpx wide; the page's day header uses the same gutter.
   Vertical positions are set in px from JS (see week-calendar.js). */
.cal {
  display: flex;
  padding: 16rpx 16rpx 24rpx 0;
  background: #fff;
}

.times {
  position: relative;
  flex: 0 0 80rpx;
}

.time {
  position: absolute;
  right: 12rpx;
  font-size: 20rpx;
  line-height: 1;
  color: var(--text-2);
  transform: translateY(-50%);
}

.cols {
  position: relative;
  flex: 1;
  display: flex;
  border-bottom: 1rpx solid var(--line);
}

.col {
  position: relative;
  flex: 1;
  min-width: 0;
  border-left: 1rpx solid var(--line);
}

.col:last-child {
  border-right: 1rpx solid var(--line);
}

.col-today {
  background: #f6faff;
}

.cal-disabled .cols {
  opacity: 0.4;
}

.cell {
  box-sizing: border-box;
  border-top: 1rpx dashed #eef1f5;
}

.cell-hour {
  border-top: 1rpx solid var(--line);
}

.past {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(233, 237, 242, 0.75);
}

.block {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  display: flex;
  flex-direction: column;
  padding: 4rpx 6rpx 4rpx 8rpx;
  border-left: 6rpx solid var(--must-blue);
  border-radius: 6rpx;
  background: var(--must-blue-soft);
  box-sizing: border-box;
  overflow: hidden;
  z-index: 2;
}

.block-name {
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 600;
  color: var(--block-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.block-purpose {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 18rpx;
  line-height: 24rpx;
  color: var(--block-text-2);
  /* English wraps at spaces; a word wider than the column is clipped, not split. */
  word-break: normal;
  overflow-wrap: normal;
}

.block-mine {
  border-left-color: var(--must-gold-line);
  background: var(--must-gold-soft);
}

.block-mine .block-name {
  color: var(--must-gold-text);
}

.block-mine .block-purpose {
  color: var(--must-gold-text-2);
}

.block-past {
  opacity: 0.55;
}

.now {
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: var(--danger);
  z-index: 3;
}

.now::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: -5rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--danger);
}

.sel {
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 12rpx 8rpx 8rpx;
  border-radius: 8rpx;
  background: var(--must-blue);
  box-shadow: 0 6rpx 16rpx rgba(0, 108, 186, 0.35);
  box-sizing: border-box;
  z-index: 5;
}

.sel-time {
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 600;
  color: #fff;
}

/* Invisible touch areas around the two dots, kept inside the day column. */
.handle {
  position: absolute;
  width: 56rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 6;
}

.handle-top {
  top: -22rpx;
  left: 0;
}

.handle-bottom {
  bottom: -22rpx;
  right: 0;
}

.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #fff;
  border: 5rpx solid var(--must-blue);
  box-sizing: border-box;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}
