.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 110;
  background: rgba(15, 25, 40, 0.4);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s, visibility 0.2s;
}

.mask-show {
  opacity: 1;
  visibility: visible;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 111;
  padding: 40rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  transform: translateY(105%);
  transition: transform 0.25s ease-out;
}

.sheet-show {
  transform: translateY(0);
}

.head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
}

.tag {
  margin-left: 16rpx;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: var(--must-gold-text);
  background: var(--must-gold-soft);
  border: 1rpx solid var(--must-gold-border);
}

.rows {
  border-top: 1rpx solid var(--line);
}

.row {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.key {
  flex: 0 0 150rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text);
  word-break: break-all;
}

.user {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--bg);
}

.nick {
  margin-right: 16rpx;
}

.openid {
  font-size: 22rpx;
  color: var(--text-3);
}

.actions {
  display: flex;
  margin-top: 40rpx;
}

.action {
  flex: 1;
}

.action + .action {
  margin-left: 24rpx;
}
